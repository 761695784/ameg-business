{
  "expo": {
    "name": "Ameg Business",
    "slug": "ameg-business",
    "version": "1.0.0",
    "scheme": "ameg-business",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#0F2D52",
    "ios": {
      "bundleIdentifier": "sn.majeliconnect.amegbusiness",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sn.majeliconnect.amegbusiness",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ameg Business accède à vos photos pour ajouter le logo de votre entreprise sur vos devis et factures.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d34743eb-8d45-429d-8f28-49f958e4faa2"
      }
    },
    "owner": "majeli"
  }
}
